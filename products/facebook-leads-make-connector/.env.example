# Meta App dashboard -> Settings -> Basic
FB_APP_SECRET=

# Any string you make up -- used only to confirm you control the deployed
# webhook URL when Facebook does its one-time verification handshake.
FB_WEBHOOK_VERIFY_TOKEN=

# --- Single-tenant (self-hosted buyer, one Facebook Page) ---
# Leave both empty if this deployment ONLY runs the hosted-subscription
# side below (tenants.py handles every incoming lead instead). See
# docs/SETUP.md step 1 -- Page Access Token with ads_management,
# leads_retrieval, pages_show_list, and pages_read_engagement scopes granted,
# exchanged for a long-lived (60-day) token.
FB_PAGE_ACCESS_TOKEN=
# The URL Make gives you when you add a "Custom Webhook" trigger module.
# See docs/make_blueprint_spec.md.
MAKE_WEBHOOK_URL=

# --- Multi-tenant hosted subscription (only if selling it this way) ---
# Leave all empty if this deployment ONLY runs the single-tenant side above.
# Stripe Dashboard -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=
# Resend Dashboard -> API Keys.
RESEND_API_KEY=
# Must be a verified sending domain in Resend, e.g. "LeadBridge <noreply@yourdomain.com>"
EMAIL_FROM_ADDRESS=
# Any long random string -- signs the download/setup email links. Generate
# with e.g. `openssl rand -hex 32`. Rotating it invalidates outstanding links.
LINK_SIGNING_SECRET=
# This deployment's own public URL, e.g. https://leadbridge.onrender.com
BASE_URL=

# Optional overrides -- defaults are in src/leadbridge/config.py
# DEDUP_DB_PATH=leadbridge_dedup.sqlite3
# TENANTS_DB_PATH=leadbridge_tenants.sqlite3
# DOWNLOAD_ZIP_PATH=dist/leadbridge-src.zip
# LINK_EXPIRY_HOURS=72
# GRAPH_API_VERSION=v21.0
