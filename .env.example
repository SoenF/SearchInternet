# Copy to .env and fill in. Loaded by config.py via plain os.environ (no pydantic).

# --- Database (Postgres + pgvector, docker-compose service "db") ---
DATABASE_URL=postgresql://opportunity_engine:opportunity_engine@localhost:5433/opportunity_engine

# --- Connector identification (required by source ToS, not API keys) ---
# SEC EDGAR's fair-access policy requires a descriptive User-Agent with contact info.
EDGAR_USER_AGENT="OpportunityEngine/0.1 (contact: davide@vamur.com)"
# Wikimedia's API etiquette also asks for a descriptive User-Agent.
WIKIPEDIA_USER_AGENT="OpportunityEngine/0.1 (contact: davide@vamur.com)"

# --- Connector enable/disable (comma-separated connector manifest names) ---
DISABLED_CONNECTORS=

# --- Embedding model ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# --- Scoring / ranking thresholds (all have code defaults; override only to tune) ---
MOMENTUM_RECENT_DAYS=7
MOMENTUM_BASELINE_DAYS=56
MOMENTUM_MIN_BASELINE_DAYS=28
DEDUP_MERGE_THRESHOLD=0.92
DEDUP_NOVEL_THRESHOLD=0.75
RESURFACE_SCORE_DELTA_PCT=0.40
BACKLOG_TOP_N=20
BACKLOG_EXPLORATION_SHARE=0.25
BACKLOG_ARBITRAGE_QUOTA=0.60
BACKLOG_MAX_CATEGORY_SHARE=0.30

# --- LLM provider (Phase 4 — not called anywhere in Phase 1-2, NoOpLLMProvider is used) ---
ANTHROPIC_API_KEY=

# --- Reddit connector (Phase 3, opt-in) ---
# Create a "script" app at https://www.reddit.com/prefs/apps to get a client
# id/secret. Left blank, the connector is silently skipped (see
# collectors/registry.py) -- ToS status is "review_needed" (see CLAUDE.md),
# so treat enabling this as a deliberate decision, not a default.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="OpportunityEngine/0.1 (contact: davide@vamur.com)"
# Comma-separated. Defaults to SaaS,Entrepreneur,smallbusiness,SideProject if unset.
REDDIT_SUBREDDITS=

# --- Product Hunt connector (Phase 3, opt-in) ---
# Get a developer token at https://www.producthunt.com/v2/oauth/applications
# (Applications tab -> your app -> "Developer Token"). Left blank, the
# connector is silently skipped -- ToS status is "review_needed" (see
# CLAUDE.md), same caveat as Reddit above.
PRODUCTHUNT_ACCESS_TOKEN=

# --- Stack Exchange connector (always enabled, no credential required) ---
# A key only raises the daily quota (300 -> 10,000); get one free at
# https://stackapps.com/apps/oauth/register if you outgrow the default quota.
STACKEXCHANGE_API_KEY=
# Comma-separated Stack Exchange site slugs. Defaults to softwarerecs
# (Software Recommendations) if unset -- its entire premise is "is there a
# tool that does X", making it a strong, low-noise pain-point source.
STACKEXCHANGE_SITES=

# --- GitHub Issues connector (always enabled, no credential required) ---
# A personal access token only raises the search rate limit (10/min -> 30/min
# for the search endpoint); create one at https://github.com/settings/tokens
# if you outgrow the default limit. No scopes needed for public search.
GITHUB_TOKEN=
# Defaults to `is:issue is:open label:enhancement` if unset.
GITHUB_SEARCH_QUERY=

# --- Competitor-saturation check (always enabled, reuses GITHUB_TOKEN above) ---
# Opportunities checked per run, highest-scored first. Batched because
# GitHub's search endpoint is rate-limited -- a large backlog's first run
# catches up incrementally over several days rather than all at once.
COMPETITOR_CHECK_BATCH_SIZE=50

# --- App Store customer reviews (always enabled, no credential required) ---
# Reviews for apps charting in Finance/Business/Lifestyle genres -- a non-
# developer-audience pain-point source (legal/accounting/real-estate/rental
# apps chart in these genres). No config needed to enable.

# --- Discourse no-code community forums (always enabled, no credential required) ---
# Comma-separated list of Discourse forum domains. Defaults to
# forum.bubble.io,community.make.com if unset -- not every Discourse
# community responds cleanly to a plain JSON GET (Cloudflare, redirects);
# see collectors/discourse_forums.py before adding more.
DISCOURSE_FORUMS=

# --- Test-only: integration tests are skipped unless this is set. ---
# MUST be a different database than DATABASE_URL above: integration tests
# TRUNCATE every app table before each test. Pointing this at your real data
# will destroy it. The `opportunity_engine_test` database lives on the same
# docker-compose Postgres instance -- create it once with:
#   docker compose exec db psql -U opportunity_engine -d postgres -c \
#     "CREATE DATABASE opportunity_engine_test OWNER opportunity_engine;"
OPPORTUNITY_ENGINE_TEST_DATABASE_URL=postgresql://opportunity_engine:opportunity_engine@localhost:5433/opportunity_engine_test
